# Macros:
# ======================================================================================================================
max_n_obstacles = 717
max_n_shelf = 20
measure_dim = 2
min_n_obstacles = 307
min_n_shelf = 20
num_objects = 3
sigma0 = 0.2

# Parameters for experiment:
# ======================================================================================================================
experiment.name = 'Warehouse Generation'

# Parameters for GridArchive:
# ======================================================================================================================
GridArchive.dims = [80, 80]
GridArchive.ranges = [[0.0, 0.0001], [307, 717]]

# Parameters for downsample/GridArchive:
# ======================================================================================================================
downsample/GridArchive.dims = [15, 25]
downsample/GridArchive.ranges = [[5, 20], [1.0, 1.3]]

# Parameters for ImprovementEmitter:
# ======================================================================================================================
ImprovementEmitter.batch_size = 20
ImprovementEmitter.restart_rule = 'no_improvement'
ImprovementEmitter.selection_rule = 'filter'
ImprovementEmitter.sigma0 = 0.2
ImprovementEmitter.weight_rule = 'truncation'

# Parameters for Manager:
# ======================================================================================================================
Manager.archive_save_freq = -1
Manager.archive_type = @GridArchive
Manager.emitter_types = [(@ImprovementEmitter, 5)]
Manager.env_manager_class = @WarehouseManager
Manager.hyper_flag = True
Manager.initial_sols = 100
Manager.inner_itrs = 10000
Manager.is_em = False
Manager.max_evals = 100
Manager.plot_metrics_freq = 1
Manager.reload_save_freq = 1
Manager.sol_size = 1731

# Parameters for WarehouseConvolutional:
# ======================================================================================================================
WarehouseConvolutional.head_dimensions = [1, 1, 1]
WarehouseConvolutional.i_size = 32
WarehouseConvolutional.n_extra_layers = 0
WarehouseConvolutional.nc = 4
WarehouseConvolutional.ndf = 64

# Parameters for WarehouseEECBSConfig:
# ======================================================================================================================
WarehouseEECBSConfig.aggregation_type = 'mean'
WarehouseEECBSConfig.bypass = True
WarehouseEECBSConfig.corridorReasoning = True
WarehouseEECBSConfig.cutoffTime = 20
WarehouseEECBSConfig.disjointSplitting = False
WarehouseEECBSConfig.hamming_only = True
WarehouseEECBSConfig.heuristics = 'WDG'
WarehouseEECBSConfig.highLevelSolver = 'EES'
WarehouseEECBSConfig.inadmissibleH = 'Global'
WarehouseEECBSConfig.lowLevelSolver = True
WarehouseEECBSConfig.measure_names = ['lambda2', 'n_obstacles']
WarehouseEECBSConfig.prioritizingConflicts = True
WarehouseEECBSConfig.rectangleReasoning = True
WarehouseEECBSConfig.restart = 0
WarehouseEECBSConfig.screen = 1
WarehouseEECBSConfig.sipp = 0
WarehouseEECBSConfig.stats = False
WarehouseEECBSConfig.suboptimality = 1.5
WarehouseEECBSConfig.targetReasoning = True
WarehouseEECBSConfig.use_warm_up = True

# Parameters for WarehouseEmulationModel:
# ======================================================================================================================
WarehouseEmulationModel.network_type = @WarehouseConvolutional
WarehouseEmulationModel.prediction_type = 'regression'
WarehouseEmulationModel.train_batch_size = 64
WarehouseEmulationModel.train_epochs = 20
WarehouseEmulationModel.train_sample_size = 20000

# Parameters for WarehouseManager:
# ======================================================================================================================
WarehouseManager.agent_num = 150
WarehouseManager.is_nca = True
WarehouseManager.lvl_height = 32
WarehouseManager.lvl_width = 32
WarehouseManager.max_n_obstacles = %max_n_obstacles
WarehouseManager.max_n_shelf = %max_n_shelf
WarehouseManager.min_n_obstacles = %min_n_obstacles
WarehouseManager.min_n_shelf = %min_n_shelf
WarehouseManager.n_endpt = 2
WarehouseManager.n_evals = 5
WarehouseManager.nca_iter = 50
WarehouseManager.num_objects = %num_objects
WarehouseManager.seed_env_path = 'maps/nca/eecbs_large_seed_block.json'
WarehouseManager.w_mode = True

# Parameters for WarehouseNCA:
# ======================================================================================================================
WarehouseNCA.kernel_size = 3
WarehouseNCA.n_aux_chan = 0
WarehouseNCA.n_hid_chan = 32
WarehouseNCA.nc = 2
