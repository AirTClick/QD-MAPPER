# ## WarehouseConfig ##

# Experiment settings
WarehouseConfig.agentNum=5                      #number of agents
WarehouseConfig.cutoffTime=7200                 #cutoff time (seconds)
WarehouseConfig.screen=1                        #screen option (0: none; 1: results; 2:all)#
WarehouseConfig.stats=False                     #write to files some detailed statistics

# CBS node selection strategies              
WarehouseConfig.highLevelSolver="EES"           #the high-level solver (A*, A*eps, EES, NEW)
WarehouseConfig.lowLevelSolver=True             #using suboptimal solver in the low level
WarehouseConfig.inadmissibleH=Global            #inadmissible heuristics (Zero, Global, Path, Local, Conflict)
WarehouseConfig.suboptimality=1.2               #suboptimality bound

# CBS improvement
WarehouseConfig.heuristics="WDG"                #admissible heuristics for the high-level search (Zero, CG,DG, WDG)
WarehouseConfig.prioritizingConflicts=True      #conflict prioirtization. If true, conflictSelection is used as a tie-breaking rule.
WarehouseConfig.bypass=True                     #Bypass1
WarehouseConfig.disjointSplitting=False         #disjoint splitting
WarehouseConfig.rectangleReasoning=True         #rectangle reasoning
WarehouseConfig.corridorReasoning=True          #corridor reasoning
WarehouseConfig.targetReasoning=True            #target reasoning
WarehouseConfig.sipp=0                          #using SIPPS as the low-level solver
WarehouseConfig.restart=0                       #rapid random restart times