# Macros:
# ======================================================================================================================
max_n_shelf = 20
measure_dim = 2
min_n_shelf = 20
num_objects = 3
sigma0 = 0.2

# Parameters for experiment:
# ======================================================================================================================
experiment.name = 'Warehouse Generation'

# Parameters for GridArchive:
# ======================================================================================================================
GridArchive.dims = [15, 100]
GridArchive.ranges = [[5, 20], [9, 14]]

# Parameters for downsample/GridArchive:
# ======================================================================================================================
downsample/GridArchive.dims = [15, 25]
downsample/GridArchive.ranges = [[5, 20], [9, 14]]

# Parameters for Manager:
# ======================================================================================================================
Manager.archive_save_freq = -1
Manager.archive_type = @GridArchive
Manager.emitter_types = [(@MapElitesBaselineEmitter, 5)]
Manager.env_manager_class = @WarehouseManager
Manager.initial_sols = 100
Manager.inner_itrs = 10000
Manager.is_em = False
Manager.max_evals = 10000
Manager.plot_metrics_freq = 1
Manager.reload_save_freq = 1
Manager.sol_size = 108

# Need more exploration 
# Parameters for MapElitesBaselineEmitter:
# ======================================================================================================================
MapElitesBaselineEmitter.batch_size = 10
MapElitesBaselineEmitter.geometric_k = True
MapElitesBaselineEmitter.initial_population = 20
MapElitesBaselineEmitter.max_n_shelf = %max_n_shelf
MapElitesBaselineEmitter.min_n_shelf = %min_n_shelf
MapElitesBaselineEmitter.mutation_k = 10
MapElitesBaselineEmitter.num_objects = %num_objects

# Parameters for WarehouseEECBSConfig:
# ======================================================================================================================
# WarehouseEECBSConfig.agentNum=5                      #number of agents
WarehouseEECBSConfig.cutoffTime=7200                 #cutoff time (seconds)
WarehouseEECBSConfig.screen=1                        #screen option (0: none; 1: results; 2:all)#
WarehouseEECBSConfig.stats=False                     #write to files some detailed statistics

# CBS node selection strategies              
WarehouseEECBSConfig.highLevelSolver="EES"           #the high-level solver (A*, A*eps, EES, NEW)
WarehouseEECBSConfig.lowLevelSolver=True             #using suboptimal solver in the low level
WarehouseEECBSConfig.inadmissibleH="Global"            #inadmissible heuristics (Zero, Global, Path, Local, Conflict)
WarehouseEECBSConfig.suboptimality=1.2               #suboptimality bound

# CBS improvement
WarehouseEECBSConfig.heuristics="WDG"                #admissible heuristics for the high-level search (Zero, CG,DG, WDG)
WarehouseEECBSConfig.prioritizingConflicts=True      #conflict prioirtization. If true, conflictSelection is used as a tie-breaking rule.
WarehouseEECBSConfig.bypass=True                     #Bypass1
WarehouseEECBSConfig.disjointSplitting=False         #disjoint splitting
WarehouseEECBSConfig.rectangleReasoning=True         #rectangle reasoning
WarehouseEECBSConfig.corridorReasoning=True          #corridor reasoning
WarehouseEECBSConfig.targetReasoning=True            #target reasoning
WarehouseEECBSConfig.sipp=0                          #using SIPPS as the low-level solver
WarehouseEECBSConfig.restart=0                       #rapid random restart times

########################### SEEMS NOT IMPORTANT WITH is_sm = FALSE ########################### 

# Parameters for WarehouseConvolutional:
# ======================================================================================================================
WarehouseConvolutional.head_dimensions = [1, 1, 1]
WarehouseConvolutional.i_size = 32
WarehouseConvolutional.n_extra_layers = 0
WarehouseConvolutional.nc = 4
WarehouseConvolutional.ndf = 64

# Parameters for WarehouseEmulationModel:
# ======================================================================================================================
WarehouseEmulationModel.network_type = @WarehouseConvolutional
WarehouseEmulationModel.prediction_type = 'regression'
WarehouseEmulationModel.train_batch_size = 64
WarehouseEmulationModel.train_epochs = 20
WarehouseEmulationModel.train_sample_size = 20000

###############################################################################################

# Parameters for WarehouseManager:
# ======================================================================================================================
WarehouseManager.agent_num = 60
WarehouseManager.lvl_height = 9
WarehouseManager.lvl_width = 12
WarehouseManager.max_n_shelf = %max_n_shelf
WarehouseManager.min_n_shelf = %min_n_shelf
WarehouseManager.n_endpt = 2
WarehouseManager.n_evals = 5
WarehouseManager.num_objects = %num_objects
WarehouseManager.w_mode = True